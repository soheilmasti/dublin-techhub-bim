{
  "Uuid": "4a71d839-813c-4e89-8d82-84918e950821",
  "IsCustomNode": false,
  "Description": "Generates 100% Real Native Revit Walls, Slabs, Levels, Ducts and Trays",
  "Name": "Dublin_TechHub_Native_BIM",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Engine": "CPython3",
      "Code": "import clr\nclr.AddReference('RevitServices')\nimport RevitServices\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\n\nclr.AddReference('RevitAPI')\nfrom Autodesk.Revit.DB import *\nfrom Autodesk.Revit.DB.Mechanical import *\nfrom Autodesk.Revit.DB.Electrical import *\n\ndoc = DocumentManager.Instance.CurrentDBDocument\n\nTransactionManager.Instance.EnsureInTransaction(doc)\n\nMM_TO_FT = 1.0 / 304.8\nfloor_height = 3800.0 * MM_TO_FT\n\n# 1. Get Default Wall & Floor Types\nwall_type = FilteredElementCollector(doc).OfClass(WallType).FirstElement()\nfloor_type = FilteredElementCollector(doc).OfClass(FloorType).FirstElement()\n\n# 2. Ensure 7 Levels\nlevels = []\nfor i in range(7):\n    elev = i * floor_height\n    lvl = None\n    for l in FilteredElementCollector(doc).OfClass(Level):\n        if abs(l.Elevation - elev) < 0.1:\n            lvl = l\n            break\n    if not lvl:\n        lvl = Level.Create(doc, elev)\n        lvl.Name = f'Level {i} - Enterprise'\n    levels.append(lvl)\n\ncreated_elements = []\nhw = (34000.0 * MM_TO_FT) / 2.0\nhd = (24000.0 * MM_TO_FT) / 2.0\n\n# 3. Create Real Walls & Floors on All 7 Levels\nfor lvl_idx, lvl in enumerate(levels):\n    p0 = XYZ(-hw, -hd, 0)\n    p1 = XYZ(hw, -hd, 0)\n    p2 = XYZ(hw, hd, 0)\n    p3 = XYZ(-hw, hd, 0)\n    \n    # Real Floor Slab\n    if floor_type:\n        try:\n            loop = CurveLoop()\n            loop.Append(Line.CreateBound(p0, p1))\n            loop.Append(Line.CreateBound(p1, p2))\n            loop.Append(Line.CreateBound(p2, p3))\n            loop.Append(Line.CreateBound(p3, p0))\n            fl = Floor.Create(doc, [loop], floor_type.Id, lvl.Id)\n            created_elements.append(fl)\n        except Exception:\n            pass\n    \n    # Real Perimeter Exterior Walls\n    if wall_type:\n        try:\n            w1 = Wall.Create(doc, Line.CreateBound(p0, p1), wall_type.Id, lvl.Id, floor_height, 0, False, False)\n            w2 = Wall.Create(doc, Line.CreateBound(p1, p2), wall_type.Id, lvl.Id, floor_height, 0, False, False)\n            w3 = Wall.Create(doc, Line.CreateBound(p2, p3), wall_type.Id, lvl.Id, floor_height, 0, False, False)\n            w4 = Wall.Create(doc, Line.CreateBound(p3, p0), wall_type.Id, lvl.Id, floor_height, 0, False, False)\n            created_elements.extend([w1, w2, w3, w4])\n        except Exception:\n            pass\n    \n    # Real Central Elevator / Core Walls\n    if wall_type:\n        try:\n            c0 = XYZ(-6000 * MM_TO_FT, 3000 * MM_TO_FT, 0)\n            c1 = XYZ(6000 * MM_TO_FT, 3000 * MM_TO_FT, 0)\n            c2 = XYZ(-6000 * MM_TO_FT, -3000 * MM_TO_FT, 0)\n            c3 = XYZ(6000 * MM_TO_FT, -3000 * MM_TO_FT, 0)\n            cw1 = Wall.Create(doc, Line.CreateBound(c0, c1), wall_type.Id, lvl.Id, floor_height, 0, False, True)\n            cw2 = Wall.Create(doc, Line.CreateBound(c2, c3), wall_type.Id, lvl.Id, floor_height, 0, False, True)\n            created_elements.extend([cw1, cw2])\n        except Exception:\n            pass\n    \n    # Level 3 Comms Room & Boardroom Interior Walls\n    if lvl_idx in [3, 4] and wall_type:\n        try:\n            cr0 = XYZ(-13000 * MM_TO_FT, -10000 * MM_TO_FT, 0)\n            cr1 = XYZ(-5000 * MM_TO_FT, -10000 * MM_TO_FT, 0)\n            cr2 = XYZ(-5000 * MM_TO_FT, -5000 * MM_TO_FT, 0)\n            rw1 = Wall.Create(doc, Line.CreateBound(cr0, cr1), wall_type.Id, lvl.Id, floor_height - (600 * MM_TO_FT), 0, False, False)\n            rw2 = Wall.Create(doc, Line.CreateBound(cr1, cr2), wall_type.Id, lvl.Id, floor_height - (600 * MM_TO_FT), 0, False, False)\n            created_elements.extend([rw1, rw2])\n        except Exception:\n            pass\n\n# 4. Create Real MEP Ducts on Level 3\nduct_type = FilteredElementCollector(doc).OfClass(DuctType).FirstElement()\nmep_sys = None\nfor s in FilteredElementCollector(doc).OfClass(MEPSystemType):\n    if s.SystemClassification == MEPSystemClassification.SupplyAir:\n        mep_sys = s\n        break\n\nif duct_type and mep_sys and len(levels) > 3:\n    try:\n        l3 = levels[3]\n        d_start = XYZ(-13000 * MM_TO_FT, 0, l3.Elevation + (2950 * MM_TO_FT))\n        d_end = XYZ(13000 * MM_TO_FT, 0, l3.Elevation + (2950 * MM_TO_FT))\n        duct = Duct.Create(doc, mep_sys.Id, duct_type.Id, l3.Id, d_start, d_end)\n        created_elements.append(duct)\n    except Exception:\n        pass\n\n# 5. Create Real Cable Trays on Level 3\ntray_type = FilteredElementCollector(doc).OfClass(CableTrayType).FirstElement()\nif tray_type and len(levels) > 3:\n    try:\n        l3 = levels[3]\n        t_start = XYZ(-14000 * MM_TO_FT, -4000 * MM_TO_FT, l3.Elevation + (2650 * MM_TO_FT))\n        t_end = XYZ(14000 * MM_TO_FT, -4000 * MM_TO_FT, l3.Elevation + (2650 * MM_TO_FT))\n        tray = CableTray.Create(doc, tray_type.Id, t_start, t_end, l3.Id)\n        created_elements.append(tray)\n    except Exception:\n        pass\n\nTransactionManager.Instance.TransactionTaskDone()\n\nOUT = f'Successfully created {len(created_elements)} 100% NATIVE Revit Walls, Floors, Ducts & Trays!'",
      "VariableInputPorts": true,
      "Id": "a1b2c3d4e5f6478980123456789abcde",
